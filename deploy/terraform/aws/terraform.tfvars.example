# Copy to terraform.tfvars and adjust. Nothing here is secret.
region             = "eu-west-2"
name               = "availabilityiq"
environment        = "prod"
kubernetes_version = "1.34"

node_instance_types = ["t3.large"]
node_min_size       = 2
node_max_size       = 4
node_desired_size   = 2

namespace       = "aiq"
service_account = "aiq-availabilityiq"

tags = {
  Owner = "hrishikesh"
}
